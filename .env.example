# Optional: Google Analytics through Firebase (src/host/analytics.ts), used by the deploy build only.
# Copy this file to .env.prod (git-ignored; the only env file the build reads) and fill it in from
# your Firebase project:
#   Firebase console → Project settings → General → Your apps → Web app → SDK setup and configuration.
# `npm run deploy` builds with `--mode prod`, which reads .env.prod. Leave the values empty
# (or skip the file) to deploy without analytics: no Firebase code runs
# and the Content Security Policy stays limited to the page's own origin.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
