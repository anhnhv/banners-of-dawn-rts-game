{
  // Machine player (AI module): runs in a Web Worker. No DOM types.
  // Network APIs exist in the WebWorker lib but are banned by lint (PLAN §6.2).
  // Its tests (tests/) are Node code and are typechecked by the root tsconfig.json.
  "extends": "../tsconfig.base.json",
  "compilerOptions": { "lib": ["ES2023", "WebWorker"], "types": [] },
  "include": ["./**/*.ts"],
  "exclude": ["tests"]
}
