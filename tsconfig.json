{
  // Root project: entry point, tests, tools and config files.
  // Each module under src/ has its own tsconfig.json with its own `lib`
  // (engine/shared/ai get NO DOM types). `npm run typecheck` checks all of them.
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["node", "vite/client"]
  },
  "include": ["src/main.ts", "tests/**/*.ts", "tools/**/*.ts", "vite.config.ts"]
}
